filters:
  and:
    - file.path.startsWith("Shared/tfm_prior_subvault/Tasks/")
properties:
  note.tags:
    displayName: Tags
  note.creation date:
    displayName: Created
views:
  - type: kanban-view
    name: Kanban
    order:
      - tags
      - creation date
      - assigned
      - category
    sort:
      - property: creation date
        direction: ASC
    columnOrders:
      file.file:
        - Shared/tfm_prior_subvault/Tasks/Checkout Astral's UV.md
        - Shared/tfm_prior_subvault/Tasks/Checkout a PR.md
        - Shared/tfm_prior_subvault/Tasks/ICML conference paper.md
        - Shared/tfm_prior_subvault/Tasks/ICML workshop papers.md
        - Shared/tfm_prior_subvault/Tasks/Play around with TFM-Playground.md
        - Shared/tfm_prior_subvault/Tasks/Play around with TabPFN and TabICL.md
      note.status:
        - backlog
        - open
        - progress
        - Done
    cardOrders:
      file.file: {}
      note.status:
        Uncategorized: []
        Progress:
          - Shared/tfm_prior_subvault/Tasks/Checkout a PR.md
          - Shared/tfm_prior_subvault/Tasks/Checkout Astral's UV.md
        done:
          - Shared/tfm_prior_subvault/Tasks/Play around with TabPFN and TabICL.md
        open:
          - Shared/tfm_prior_subvault/Tasks/Checkout Astral's UV.md
        progress:
          - Shared/tfm_prior_subvault/Tasks/Literature on DAG findings.md
        Done:
          - Shared/tfm_prior_subvault/Tasks/Checkout a PR.md
          - Shared/tfm_prior_subvault/Tasks/Play around with TFM-Playground.md
          - Shared/tfm_prior_subvault/Tasks/ICML workshop papers.md
          - Shared/tfm_prior_subvault/Tasks/Play around with TabPFN and TabICL.md
          - Shared/tfm_prior_subvault/Tasks/ICML conference paper.md
          - Shared/tfm_prior_subvault/Tasks/TabICLv2 prior.md
          - Shared/tfm_prior_subvault/Tasks/Explore TFM codebase.md
        backlog:
          - Shared/tfm_prior_subvault/Tasks/Evaluation of number of features.md
          - Shared/tfm_prior_subvault/Tasks/Full evaluation pipeline.md
      "note.status\x1fnote.tags": {}
    columnColors:
      file.file: {}
      note.status: {}
    groupByProperty: note.status
    quickAddFolder: Shared/tfm_prior_subvault/Tasks
    swimlaneOrders:
      "note.status\x1fnote.tags":
        - "#another-test-tag"
        - "#test-tag"
        - Uncategorized
    collapsedLanes:
      "note.status\x1fnote.tags": []
    wrapPropertyValues: true
  - type: table
    name: Table
    order:
      - file.name
      - creation date
      - status
    sort:
      - property: creation date
        direction: ASC
    columnSize:
      file.name: 376
newItemFolder: Shared/tfm_prior_subvault/Tasks
